# Main NIDO WordPress (subdirectory). Editors log in at:
# https://www.nidomontessori.in/blog/wp-admin
# Only /blogs uses this API. Other pages stay in this React app.
WORDPRESS_URL=https://blognidomontessoriin-14b003d.ingress-earth.ewp.live

# Native WordPress Posts only (Add Post in wp-admin).
WORDPRESS_CONTENT_TYPE=posts

# Research-site posts use this category and are hidden from school /blogs.
WORDPRESS_EXCLUDE_CATEGORY=research
